# Plantilla del .env de PRODUCCIÓN (Hostinger). Copiar a `.env` en el servidor y completar.
# Nunca subir el .env real a Git.

APP_NAME="Boda Miguel & Daniela"
APP_ENV=production
APP_KEY=                      # se genera en el servidor: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://miguelydaniela.site

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos creada en hPanel → Bases de datos (MySQL/MariaDB).
# En Hostinger el host casi siempre es 127.0.0.1 o localhost.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# La clave del panel /admin NO va aquí: se crea en el servidor con `php artisan admin:password`.

# Evento (opcionales: ya tienen estos valores por defecto en config/wedding.php)
WEDDING_THEME=clasico
WEDDING_STARTS_AT="2026-12-19 16:00:00"
WEDDING_RSVP_DEADLINE="2026-12-04 23:59:59"
